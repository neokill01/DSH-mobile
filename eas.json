{
  "cli": {
    "version": ">= 21.8.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": true,
        "autoIncrement": "buildNumber"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "autoIncrement": "buildNumber"
      }
    },
    "development-android": {
      "developmentClient": true,
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true
    },
    "preview-ios": {
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "autoIncrement": "buildNumber"
      }
    },
    "preview-android": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk",
        "autoIncrement": "versionCode"
      }
    },
    "production": {
      "autoIncrement": true,
      "updates": {
        "url": "https://u.expo.dev/043fb6f4-5b62-4271-9026-e0c45c92d452"
      }
    },
    "production-ios": {
      "autoIncrement": true,
      "ios": {
        "autoIncrement": "buildNumber"
      },
      "updates": {
        "url": "https://u.expo.dev/043fb6f4-5b62-4271-9026-e0c45c92d452"
      }
    },
    "production-android": {
      "autoIncrement": true,
      "android": {
        "autoIncrement": "versionCode"
      },
      "updates": {
        "url": "https://u.expo.dev/043fb6f4-5b62-4271-9026-e0c45c92d452"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
